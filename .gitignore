# ==========================================
# .gitignore — Projet ACPDPH (Fullstack)
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
dist-ssr/
*.tsbuildinfo

# Environment variables & secrets (NEVER commit secrets)
.env
.env.*
*.env
atlas-credentials*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS and system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace

# Test coverage & reports
coverage/
.nyc_output/

# Temporary and backup files
*.tmp
*.bak
*.swp
*.orig

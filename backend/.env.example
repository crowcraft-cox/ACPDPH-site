# Variables d'environnement Backend — ACPDPH API
# Copiez ce fichier en ".env" et remplissez les valeurs réelles

# Serveur
PORT=3001
NODE_ENV=production

# Base de données MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://VOTRE_USER:VOTRE_MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/acpdph?retryWrites=true&w=majority

# Authentification JWT (utilisez une chaîne longue et aléatoire)
JWT_SECRET=remplacez-par-une-chaine-secrete-longue-et-aleatoire-2026

# Mot de passe Admin (Super-Admin)
ADMIN_PASSWORD=VotreMotDePasseAdmin2026

# Nodemailer — Envoi d'emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre-email@gmail.com
EMAIL_PASS=votre-mot-de-passe-application-gmail

# CORS — URL du frontend Vercel (sans slash final)
FRONTEND_URL=https://acpdph.vercel.app
